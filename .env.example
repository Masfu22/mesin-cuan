# Contoh lokal — salin menjadi .env. Jangan commit file .env.
# Isi minimal satu AI provider yang didukung.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEYS=
# Model gratis default Google AI Studio; tidak perlu dibuat sebagai GitHub Secret.
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
PROVIDER_A_API_KEY=
PROVIDER_A_BASE_URL=
PROVIDER_A_MODEL=
PROVIDER_B_API_KEY=
PROVIDER_B_BASE_URL=
PROVIDER_B_MODEL=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# YouTube / Google Drive
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# Footage opsional. Mixkit scraper + Wikimedia Commons tidak perlu key.
PIXABAY_API_KEY=
COVERR_API_KEY=
COVERR_APP_ID=
PEXELS_API_KEY=

# Riset, audio, dan layanan tambahan
PERPLEXITY_API_KEY=
FREESOUND_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Notifikasi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime defaults
TTS_MODE=edge
RENDER_PRESET=fast
LOG_LEVEL=INFO
