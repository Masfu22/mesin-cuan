# Contoh lokal — salin menjadi .env. Jangan commit file .env.
# Isi minimal satu AI provider yang didukung.
# AI utama — Ollama lokal atau Ollama Cloud
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v3.1:671b-cloud

GEMINI_API_KEY=
# Default model; can be overridden with GitHub Secret GEMINI_MODEL
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GROQ_API_KEY=
PROVIDER_A_API_KEY=
PROVIDER_A_BASE_URL=
PROVIDER_A_MODEL=
PROVIDER_B_API_KEY=
PROVIDER_B_BASE_URL=
PROVIDER_B_MODEL=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# NVIDIA hosted NIM free tier: evaluation/testing only; do not enable in production
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_ENABLE_FREE_FALLBACK=0

# YouTube / Google Drive
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# Footage opsional. Mixkit scraper + Wikimedia Commons tidak perlu key.
PIXABAY_API_KEY=
COVERR_API_KEY=
COVERR_APP_ID=
PEXELS_API_KEY=

# Riset, audio, dan layanan tambahan
PERPLEXITY_API_KEY=
FREESOUND_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Notifikasi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime defaults
TTS_MODE=edge
RENDER_PRESET=fast
LOG_LEVEL=INFO
